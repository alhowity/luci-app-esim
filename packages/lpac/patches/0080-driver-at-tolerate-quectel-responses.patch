From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 22 Nov 2026 16:00:00 +0000
Subject: [PATCH] driver: at: tolerate Quectel RM551E-GL responses

The Quectel RM551E-GL implements AT+CCHO, AT+CCHC and AT+CGLA but answers
their "=?" test form with an error, so lpac aborted with "Device missing
AT+CCHO support" before opening a channel. Treat those probes as hints and
let the real CCHO/CGLA exchange decide.

Also handle responses that previously made lpac wait forever:

- treat "+CME ERROR" and "+CMS ERROR" as final error results (the
  RM551E-GL returns "+CME ERROR: 3" when closing an unused channel);
- stop when the AT device read fails or reaches EOF;
- accept the bare <sessionid> AT+CCHO response defined by 3GPP TS 27.007
  in addition to the "+CCHO: " form, and reject channel 0.

AT debug output now goes to stderr so it cannot corrupt lpac's JSON on
stdout.
---
 driver/apdu/at.c | 50 ++++++++++++++++++++++++++++++++++----------------
 1 file changed, 34 insertions(+), 16 deletions(-)

--- a/driver/apdu/at.c
+++ b/driver/apdu/at.c
@@ -46,17 +46,30 @@ static int at_expect(char **response, co
         *response = NULL;
 
     while (1) {
-        fgets(buffer, AT_BUFFER_SIZE, fuart);
+        if (fgets(buffer, AT_BUFFER_SIZE, fuart) == NULL) {
+            fprintf(stderr, "AT device read failed or closed\n");
+            return -1;
+        }
         buffer[strcspn(buffer, "\r\n")] = 0;
         if (getenv_or_default(ENV_AT_DEBUG, false))
-            printf("AT_DEBUG: %s\n", buffer);
-        if (strcmp(buffer, "ERROR") == 0) {
+            fprintf(stderr, "AT_DEBUG: %s\n", buffer);
+        if (strcmp(buffer, "ERROR") == 0 || strncmp(buffer, "+CME ERROR", 10) == 0
+            || strncmp(buffer, "+CMS ERROR", 10) == 0) {
             return -1;
         } else if (strcmp(buffer, "OK") == 0) {
             return 0;
         } else if (expected && strncmp(buffer, expected, strlen(expected)) == 0) {
-            if (response)
+            if (response) {
+                free(*response);
                 *response = strdup(buffer + strlen(expected));
+            }
+        } else if (expected && strcmp(expected, "+CCHO: ") == 0 && buffer[0] != '\0'
+                   && strspn(buffer, "0123456789") == strlen(buffer)) {
+            /* 3GPP TS 27.007 returns a bare <sessionid> for +CCHO. */
+            if (response) {
+                free(*response);
+                *response = strdup(buffer);
+            }
         }
     }
     return 0;
@@ -74,21 +87,20 @@ static int apdu_interface_connect(struct
     }
     setbuf(fuart, NULL);
 
+    /*
+     * Some modems (for example the Quectel RM551E-GL) implement CCHO, CCHC
+     * and CGLA but reject their "=?" test form. Treat the probes as hints;
+     * the real CCHO/CGLA exchange still fails closed when unsupported.
+     */
     fprintf(fuart, "AT+CCHO=?\r\n");
-    if (at_expect(NULL, NULL)) {
-        fprintf(stderr, "Device missing AT+CCHO support\n");
-        return -1;
-    }
+    if (at_expect(NULL, NULL))
+        fprintf(stderr, "Device rejected AT+CCHO=?, trying AT+CCHO anyway\n");
     fprintf(fuart, "AT+CCHC=?\r\n");
-    if (at_expect(NULL, NULL)) {
-        fprintf(stderr, "Device missing AT+CCHC support\n");
-        return -1;
-    }
+    if (at_expect(NULL, NULL))
+        fprintf(stderr, "Device rejected AT+CCHC=?, trying AT+CCHC anyway\n");
     fprintf(fuart, "AT+CGLA=?\r\n");
-    if (at_expect(NULL, NULL)) {
-        fprintf(stderr, "Device missing AT+CGLA support\n");
-        return -1;
-    }
+    if (at_expect(NULL, NULL))
+        fprintf(stderr, "Device rejected AT+CGLA=?, trying AT+CGLA anyway\n");
 
     return 0;
 }
@@ -175,12 +187,18 @@ static int apdu_interface_logic_channel_
     }
     fprintf(fuart, "\"\r\n");
     if (at_expect(&response, "+CCHO: ")) {
+        free(response);
         return -1;
     }
     if (response == NULL) {
         return -1;
     }
     logic_channel = atoi(response);
+    free(response);
+    if (logic_channel <= 0) {
+        logic_channel = 0;
+        return -1;
+    }
 
     return logic_channel;
 }
