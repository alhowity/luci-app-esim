+    _cleanup_es10b_notification_metadata_list_ struct es10b_notification_metadata_list *notifications = NULL, *rptr = NULL;
     cJSON *jdata = NULL;
 
     if (es10b_list_notification(&euicc_ctx, &notifications)) {
