From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Amperstrand <141745238+Amperstrand@users.noreply.github.com>
Date: Sun, 8 Nov 2026 15:38:59 +0100
Subject: [PATCH] applet: avoid use-before-init for SBRM variables

Backport upstream lpac pull request 467 / commit
a9b21ac53ec334a86e1903e513d15e21a2f36c78.

Several applets declare _cleanup_ decorated locals without initializing
them. When an early ES10 call fails, for example because the modem rejects
the first STORE DATA APDU, teardown frees uninitialized stack values and
lpac crashes after printing its error JSON. Zero-initialize those locals.
---
 src/applet/chip/info.c            | 6 +++---
 src/applet/notification/dump.c    | 4 ++--
 src/applet/notification/list.c    | 2 +-
 src/applet/notification/process.c | 4 ++--
 src/applet/notification/remove.c  | 2 +-
 src/applet/notification/replay.c  | 2 +-
 src/applet/profile/list.c         | 2 +-
 7 files changed, 11 insertions(+), 11 deletions(-)

--- a/src/applet/chip/info.c
+++ b/src/applet/chip/info.c
@@ -14,9 +14,9 @@
 
 static int applet_main(int argc, char **argv) {
     _cleanup_free_ char *eid = NULL;
-    _cleanup_(es10a_euicc_configured_addresses_free) struct es10a_euicc_configured_addresses addresses;
-    _cleanup_es10b_rat_list_ struct es10b_rat *ratList;
-    _cleanup_(es10c_ex_euiccinfo2_free) struct es10c_ex_euiccinfo2 euiccinfo2;
+    _cleanup_(es10a_euicc_configured_addresses_free) struct es10a_euicc_configured_addresses addresses = {0};
+    _cleanup_es10b_rat_list_ struct es10b_rat *ratList = NULL;
+    _cleanup_(es10c_ex_euiccinfo2_free) struct es10c_ex_euiccinfo2 euiccinfo2 = {0};
     cJSON *jaddresses = NULL, *jratList = NULL, *jeuiccinfo2 = NULL, *jdata = NULL;
 
     if (es10c_get_eid(&euicc_ctx, &eid)) {
--- a/src/applet/notification/dump.c
